# NairobiX Portal — environment variables.
# Copy to .env.local for development. In production, set these in Vercel
# (Project → Settings → Environment Variables), never in the repository.
# Only NEXT_PUBLIC_ variables are visible to the browser.

# --- Portal -----------------------------------------------------------------

# Required. HMAC key for the nx_session cookie, at least 32 characters.
# Generate with: openssl rand -base64 48   (use a different value per environment)
NAIROBIX_SESSION_SECRET=

# Canonical public origin; also the base of the magic-link callback
# (<origin>/auth/callback). Defaults to https://portal.nairobix.com.
# Use http://localhost:3000 locally when testing Supabase sign-in.
NAIROBIX_PORTAL_ORIGIN=https://portal.nairobix.com

# Optional. Shown on access-state screens and used for Portal support requests.
NEXT_PUBLIC_NAIROBIX_SUPPORT_EMAIL=support@nairobix.com

# Optional. Seconds an authorization decision / CRM read is cached (30–3600, default 300).
NAIROBIX_AUTHZ_CACHE_TTL_SECONDS=300

# Optional. ISO currency for CRM amounts (Zoho returns org-currency numbers). Default KES.
NAIROBIX_CURRENCY=KES

# --- Supabase Auth (authentication only) ----------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Zoho CRM (server-only) -----------------------------------------------------
# Self Client scopes: ZohoCRM.modules.READ, ZohoCRM.modules.Cases.CREATE, ZohoCRM.users.READ
# (plus ZohoCRM.settings.fields.READ, ZohoCRM.settings.modules.READ for schema discovery)

ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Shared secret for /api/zoho/webhook (at least 32 characters).
ZOHO_WEBHOOK_SECRET=

# --- Development only ------------------------------------------------------------
# Outside production the Portal uses demo users and data. Set NAIROBIX_CRM=zoho
# to develop against the real CRM instead. Production always uses Zoho.
# NAIROBIX_CRM=zoho
